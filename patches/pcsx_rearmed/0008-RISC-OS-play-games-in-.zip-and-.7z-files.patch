+void arc_clear_dir(const char *dir)
+{
+	DIR *d = opendir(dir);
+	struct dirent *e;
+	char (*names)[256] = NULL;
+	int n = 0, cap = 0, i;
+	if (d == NULL)
+		return;
+	while ((e = readdir(d)) != NULL) {
+		if (e->d_name[0] == '.' && (!e->d_name[1] || (e->d_name[1] == '.' && !e->d_name[2])))
+			continue;
+		if (n == cap) {
+			void *nn = realloc(names, (cap = cap ? cap * 2 : 32) * sizeof *names);
+			if (nn == NULL)
+				break;
+			names = nn;
+		}
+		snprintf(names[n++], 256, "%s", e->d_name);
+	}
+	closedir(d);
+	for (i = 0; i < n; i++) {
+		char p[1100];
+		struct stat st;
+		snprintf(p, sizeof p, "%s/%s", dir, names[i]);
+		if (stat(p, &st) == 0 && S_ISDIR(st.st_mode)) {
+			arc_clear_dir(p);
+			rmdir(p);
+		} else
+			remove(p);
+	}
+	free(names);
+}
diff --git a/frontend/riscos/archive.h b/frontend/riscos/archive.h
