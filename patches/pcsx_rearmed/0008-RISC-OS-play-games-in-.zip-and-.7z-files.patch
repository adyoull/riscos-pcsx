+			return 0;
+		for (i = (int)a->db.FolderToFile[a->m[k].folder]; i < k; i++)
+			if (a->m[i].folder == a->m[k].folder)
+				skip += a->m[i].size;
+		if (skip > PEEK_SKIP_MAX || !sz_folder_stream(a, a->m[k].folder, NULL, 0)) {
+			dec_end(a);
+			return -1;
+		}
+		while (skip) {
+			long n = dec_read(a, a->buf, skip < OUTBUF ? (size_t)skip : OUTBUF, NULL, 0);
+			if (n <= 0) {
+				dec_end(a);
+				return -1;
+			}
+			skip -= (u64)n;
+		}
+	}
+	if ((u64)max > a->m[k].size)
+		max = (long)a->m[k].size;
