+	for (i = 0; i < a->n && k < 0; i++)
+		if (!a->m[i].is_dir && !strcasecmp(a->m[i].name, name))
+			k = i;
+	for (i = 0; i < a->n && k < 0; i++)
+		if (!a->m[i].is_dir && !strcasecmp(leafof(a->m[i].name), leafof(name)))
+			k = i;
+	if (k < 0 || a->mi >= 0)
+		return -1;
+	if (size)
+		*size = (double)a->m[k].size;
+	if (a->buf == NULL && (a->buf = malloc(OUTBUF)) == NULL)
+		return -1;
+	if (a->type == ARC_ZIP) {
+		if (!zip_stream(a, k, NULL, 0))
+			return -1;
+	} else {
