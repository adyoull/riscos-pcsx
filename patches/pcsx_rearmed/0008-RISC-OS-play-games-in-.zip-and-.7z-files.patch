+/*
+ * Games in .zip and .7z archives (see archive.h).
+ *
+ * Zip: the central directory (zip64 too) lists the members; each is
+ * inflated with miniz (in the core already), or copied, or decoded with
+ * the LZMA SDK. 7z: the LZMA SDK reads the archive's headers; its own
+ * decoder unpacks a whole solid block into memory, so for LZMA, LZMA2 and
+ * copy (what 7-Zip uses for disc images) the block is decoded here as a
+ * stream instead, and split into its files as it comes.
+ *
+ * Unpacked names: anything RISC OS can't have in a file name becomes _,
+ * spaces become hard spaces (on RISC OS), and the FILE lines of .cue
+ * files and the lines of .m3u files are changed to match.
+ *
+ * Copyright (C) 2026 Andrew Youll. GPL-2.0-or-later, as PCSX ReARMed.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <stdarg.h>
+#include <dirent.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include "archive.h"
+#include "miniz.h"
+#include "lzma/7z.h"
+#include "lzma/7zCrc.h"
+#include "lzma/LzmaDec.h"
+#include "lzma/Lzma2Dec.h"
+
+typedef unsigned long long u64;
+
+#define INBUF (256u << 10)
+#define OUTBUF (1u << 20)
+#define TEXT_MAX (256u << 10)
+#define MAX_MEMBERS 4096
+#define PEEK_SKIP_MAX (4u << 20)
+
+enum { C_NONE, C_COPY, C_DEFLATE, C_LZMA, C_LZMA2, C_MEM };
+
+struct member {
+	char name[512];          /* as stored (UTF-8), '/' between folders */
+	char out[512];           /* as written, relative to the folder */
+	u64 size;
+	int is_dir;
+	unsigned crc;
+	int has_crc;
+	/* zip */
+	int method, flags;
+	u64 csize, lh_off;
+	/* 7z: the solid block (folder) it's in; -1 = no data */
+	int folder;
+};
+
+typedef struct {
+	ISeekInStream vt;
+	FILE *f;
+} seek_file;
+
+struct arc {
+	int type;
+	FILE *f;
+	struct member *m;
+	int n, game;
+	u64 total, done;
+
+	/* 7z */
+	int sz_open;
+	CSzArEx db;
+	seek_file seek;
+	CLookToRead2 look;
+	unsigned char *lookbuf;
+
+	/* the stream being decoded */
+	int coder;
+	u64 pack_left, unpack_left;
+	unsigned char *in;
+	size_t in_pos, in_len;
+	mz_stream zs;
+	int zs_live;
+	CLzmaDec lz;
+	CLzma2Dec lz2;
+	int lz_live, lz2_live;
+	unsigned char *mem;
+	size_t mem_pos, mem_len;
+	unsigned char *buf;
+
+	/* unpacking */
+	int started, phase, cur, file_i, folder_live;
+	char dir[512], game_path[1100];
+	int mi;                    /* the member being written, -1 none */
+	FILE *out;
+	u64 out_left;
+	unsigned crc_run;
+	unsigned char *text;
+	size_t text_len;
+};
+
+static void *sz_alloc(ISzAllocPtr p, size_t size) { (void)p; return size ? malloc(size) : NULL; }
+static void sz_free(ISzAllocPtr p, void *a) { (void)p; free(a); }
+static const ISzAlloc g_alloc = { sz_alloc, sz_free };
+
+static void fail(char *err, int len, const char *fmt, ...)
+{
+	va_list ap;
+	if (err == NULL || len <= 0)
+		return;
+	va_start(ap, fmt);
+	vsnprintf(err, len, fmt, ap);
+	va_end(ap);
+}
+
+static const char *leafof(const char *p)
+{
+	const char *s = strrchr(p, '/');
+	return s ? s + 1 : p;
+}
+
+static const char *extof(const char *p)
+{
+	const char *l = leafof(p), *d = strrchr(l, '.');
+	return d ? d : "";
+}
+
+static unsigned g16(const unsigned char *p) { return p[0] | p[1] << 8; }
+static unsigned g32(const unsigned char *p) { return p[0] | p[1] << 8 | p[2] << 16 | (unsigned)p[3] << 24; }
+static u64 g64(const unsigned char *p) { return g32(p) | (u64)g32(p + 4) << 32; }
+
+/* ---- what a file is ---- */
+
+int arc_ext(const char *path)
+{
+	const char *e = extof(path);
+	if (!strcasecmp(e, ".zip"))
+		return ARC_ZIP;
+	if (!strcasecmp(e, ".7z"))
+		return ARC_7Z;
+	return ARC_NONE;
+}
+
+int arc_type(const char *path)
+{
+	unsigned char b[6];
+	FILE *f = fopen(path, "rb");
+	size_t n;
+	if (f == NULL)
+		return ARC_NONE;
+	n = fread(b, 1, 6, f);
+	fclose(f);
+	if (n >= 4 && b[0] == 'P' && b[1] == 'K' && ((b[2] == 3 && b[3] == 4) || (b[2] == 5 && b[3] == 6)))
+		return ARC_ZIP;
+	if (n == 6 && !memcmp(b, "7z\xBC\xAF\x27\x1C", 6))
+		return ARC_7Z;
+	return ARC_NONE;
+}
+
+/* ---- names ---- */
+
+/* One character of NAME (UTF-8 if it is, else Latin-1) as a Latin-1 byte;
+   *used gets how many bytes it took. */
+static int latin1(const unsigned char *s, int *used)
+{
+	unsigned c = s[0];
+	int k, n;
+	*used = 1;
+	if (c < 0x80)
+		return c;
+	n = c >= 0xF0 && c < 0xF8 ? 3 : c >= 0xE0 ? 2 : c >= 0xC2 && c < 0xE0 ? 1 : 0;
+	if (c >= 0xF8)
+		n = 0;
+	for (k = 1; k <= n; k++)
+		if ((s[k] & 0xC0) != 0x80)
+			return c;            /* not UTF-8: Latin-1 already */
+	if (n == 0)
+		return c;
+	*used = n + 1;
+	if (n == 1)
+		return ((c & 0x1F) << 6) | (s[1] & 0x3F);   /* U+0080..U+07FF */
+	return '_';
+}
+
+static int fix_char(int c)
+{
+	if (c < 0x20 || c == 0x7F || strchr("$&%@\\^:#*\"|<>?", c))
+		return '_';
+	if (c >= 0x100)
+		return '_';
+#ifdef __riscos__
+	if (c == ' ')
+		return 0xA0;
+#endif
+	return c;
+}
+
+void arc_disc_name(const char *name, char *out, int len)
+{
+	const unsigned char *s = (const unsigned char *)name;
+	int o = 0;
+	while (*s && o < len - 1) {
+		const unsigned char *e = s;
+		int seglen, k;
+		while (*e && *e != '/' && *e != '\\')
+			e++;
+		seglen = (int)(e - s);
+		if (seglen == 0 || (seglen == 1 && s[0] == '.') || (seglen == 2 && s[0] == '.' && s[1] == '.')) {
+			s = *e ? e + 1 : e;
+			continue;
+		}
+		if (o && o < len - 1)
+			out[o++] = '/';
+		for (k = 0; k < seglen && o < len - 1;) {
+			int used, c = latin1(s + k, &used);
+			if (k + used > seglen)
+				used = seglen - k;
+			out[o++] = (char)fix_char(c);
+			k += used;
+		}
+		s = *e ? e + 1 : e;
+	}
+	out[o] = 0;
+}
+
+/* ---- opening ---- */
+
+static int add_member(struct arc *a, struct member *mm)
+{
+	if (a->n == MAX_MEMBERS)
+		return 0;
+	if (a->m == NULL && (a->m = calloc(MAX_MEMBERS, sizeof *a->m)) == NULL)
+		return 0;
+	a->m[a->n++] = *mm;
+	return 1;
+}
+
+static int zip_open(struct arc *a, long fsize, char *err, int errlen)
+{
+	long tail = fsize < 65557 ? fsize : 65557, i;
+	unsigned char *t = malloc(tail > 0 ? tail : 1), *cd = NULL, *e = NULL;
+	u64 n = 0, cdsize = 0, cdoff = 0, k, p;
+	int ok = 0;
+	if (t == NULL || fseek(a->f, fsize - tail, SEEK_SET) || fread(t, 1, tail, a->f) != (size_t)tail)
+		goto out;
+	for (i = tail - 22; i >= 0; i--)
+		if (t[i] == 'P' && t[i + 1] == 'K' && t[i + 2] == 5 && t[i + 3] == 6) {
+			e = t + i;
+			break;
+		}
+	if (e == NULL) {
+		fail(err, errlen, "it isn't a zip file PCSX can read (no directory at the end)");
+		goto out;
+	}
+	n = g16(e + 10);
+	cdsize = g32(e + 12);
+	cdoff = g32(e + 16);
+	if ((n == 0xFFFF || cdsize == 0xFFFFFFFFu || cdoff == 0xFFFFFFFFu) && i >= 20 &&
+	    !memcmp(e - 20, "PK\6\7", 4)) {
+		unsigned char z[56];
+		u64 zo = g64(e - 20 + 8);
+		if (zo < (u64)fsize && !fseek(a->f, (long)zo, SEEK_SET) &&
+		    fread(z, 1, 56, a->f) == 56 && !memcmp(z, "PK\6\6", 4)) {
+			n = g64(z + 32);
+			cdsize = g64(z + 40);
+			cdoff = g64(z + 48);
+		}
+	}
+	if (cdsize > (16u << 20) || cdoff + cdsize > (u64)fsize) {
+		fail(err, errlen, "its directory is damaged");
+		goto out;
+	}
+	cd = malloc(cdsize ? cdsize : 1);
+	if (cd == NULL || fseek(a->f, (long)cdoff, SEEK_SET) || fread(cd, 1, cdsize, a->f) != cdsize) {
+		fail(err, errlen, "its directory couldn't be read");
+		goto out;
+	}
+	for (k = 0, p = 0; k < n && p + 46 <= cdsize; k++) {
+		struct member mm;
+		unsigned nl, xl, cl, x;
+		const unsigned char *h = cd + p;
+		if (memcmp(h, "PK\1\2", 4))
+			break;
+		memset(&mm, 0, sizeof mm);
+		nl = g16(h + 28);
+		xl = g16(h + 30);
+		cl = g16(h + 32);
+		if (p + 46 + nl + xl + cl > cdsize)
+			break;
+		mm.flags = g16(h + 8);
+		mm.method = g16(h + 10);
+		mm.crc = g32(h + 16);
+		mm.has_crc = 1;
+		mm.csize = g32(h + 20);
+		mm.size = g32(h + 24);
+		mm.lh_off = g32(h + 42);
+		snprintf(mm.name, sizeof mm.name, "%.*s", nl < 511 ? (int)nl : 511, (const char *)h + 46);
+		/* zip64: the sizes and offset that didn't fit, in that order */
+		for (x = 0; x + 4 <= xl;) {
+			const unsigned char *xp = h + 46 + nl + x;
+			unsigned id = g16(xp), sz = g16(xp + 2), q = 4;
+			if (x + 4 + sz > xl)
+				break;
+			if (id == 1) {
+				if (mm.size == 0xFFFFFFFFu && q + 8 <= sz + 4) { mm.size = g64(xp + q); q += 8; }
+				if (mm.csize == 0xFFFFFFFFu && q + 8 <= sz + 4) { mm.csize = g64(xp + q); q += 8; }
+				if (mm.lh_off == 0xFFFFFFFFu && q + 8 <= sz + 4) { mm.lh_off = g64(xp + q); q += 8; }
+			}
+			x += 4 + sz;
+		}
+		p += 46 + nl + xl + cl;
+		mm.is_dir = nl > 0 && (mm.name[strlen(mm.name) - 1] == '/' || mm.name[strlen(mm.name) - 1] == '\\');
+		mm.folder = -1;
+		/* Mac clutter */
+		if (!strncmp(mm.name, "__MACOSX/", 9) || !strncmp(leafof(mm.name), "._", 2))
+			continue;
+		if (!add_member(a, &mm))
+			break;
+	}
+	ok = 1;
+out:
+	free(t);
+	free(cd);
+	return ok;
+}
+
+static SRes sf_read(ISeekInStreamPtr pp, void *buf, size_t *size)
+{
+	seek_file *p = Z7_CONTAINER_FROM_VTBL(pp, seek_file, vt);
+	*size = fread(buf, 1, *size, p->f);
+	return ferror(p->f) ? SZ_ERROR_READ : SZ_OK;
+}
+
+static SRes sf_seek(ISeekInStreamPtr pp, Int64 *pos, ESzSeek origin)
+{
+	seek_file *p = Z7_CONTAINER_FROM_VTBL(pp, seek_file, vt);
+	int w = origin == SZ_SEEK_SET ? SEEK_SET : origin == SZ_SEEK_CUR ? SEEK_CUR : SEEK_END;
+	long r;
+	if (fseek(p->f, (long)*pos, w))
+		return SZ_ERROR_READ;
+	r = ftell(p->f);
+	if (r < 0)
+		return SZ_ERROR_READ;
+	*pos = r;
+	return SZ_OK;
+}
+
+static void utf16_to_utf8(const UInt16 *s, char *out, int len)
+{
+	int o = 0;
+	while (*s && o < len - 4) {
+		unsigned c = *s++;
+		if (c >= 0xD800 && c < 0xDC00 && *s >= 0xDC00 && *s < 0xE000)
+			c = 0x10000 + ((c - 0xD800) << 10) + (*s++ - 0xDC00);
+		if (c < 0x80)
+			out[o++] = (char)c;
+		else if (c < 0x800) {
+			out[o++] = (char)(0xC0 | c >> 6);
+			out[o++] = (char)(0x80 | (c & 0x3F));
+		} else if (c < 0x10000) {
+			out[o++] = (char)(0xE0 | c >> 12);
+			out[o++] = (char)(0x80 | ((c >> 6) & 0x3F));
+			out[o++] = (char)(0x80 | (c & 0x3F));
+		} else {
+			out[o++] = (char)(0xF0 | c >> 18);
+			out[o++] = (char)(0x80 | ((c >> 12) & 0x3F));
+			out[o++] = (char)(0x80 | ((c >> 6) & 0x3F));
+			out[o++] = (char)(0x80 | (c & 0x3F));
+		}
+	}
+	out[o] = 0;
+}
+
+static int sz_open(struct arc *a, char *err, int errlen)
+{
+	static int crc_ready;
+	SRes r;
+	UInt32 i;
+	UInt16 name16[512];
+	if (!crc_ready) {
+		CrcGenerateTable();
+		crc_ready = 1;
+	}
+	a->seek.vt.Read = sf_read;
+	a->seek.vt.Seek = sf_seek;
+	a->seek.f = a->f;
+	if ((a->lookbuf = malloc(1 << 16)) == NULL) {
+		fail(err, errlen, "there isn't enough memory");
+		return 0;
+	}
+	LookToRead2_CreateVTable(&a->look, False);
+	a->look.buf = a->lookbuf;
+	a->look.bufSize = 1 << 16;
+	a->look.realStream = &a->seek.vt;
+	LookToRead2_INIT(&a->look);
+	SzArEx_Init(&a->db);
+	r = SzArEx_Open(&a->db, &a->look.vt, &g_alloc, &g_alloc);
+	if (r != SZ_OK) {
+		fail(err, errlen, r == SZ_ERROR_UNSUPPORTED ? "it's a kind of 7z PCSX can't read (encrypted?)" :
+		     r == SZ_ERROR_MEM ? "there isn't enough memory to read its directory" :
+		     "it isn't a 7z file PCSX can read (error %d)", (int)r);
+		SzArEx_Free(&a->db, &g_alloc);
+		return 0;
+	}
+	a->sz_open = 1;
+	for (i = 0; i < a->db.NumFiles; i++) {
+		struct member mm;
+		memset(&mm, 0, sizeof mm);
+		if (SzArEx_GetFileNameUtf16(&a->db, i, NULL) > 512)
+			name16[0] = 0;
+		else
+			SzArEx_GetFileNameUtf16(&a->db, i, name16);
+		utf16_to_utf8(name16, mm.name, sizeof mm.name);
+		mm.is_dir = SzArEx_IsDir(&a->db, i);
+		mm.size = SzArEx_GetFileSize(&a->db, i);
+		mm.has_crc = SzBitWithVals_Check(&a->db.CRCs, i);
+		mm.crc = mm.has_crc ? a->db.CRCs.Vals[i] : 0;
+		mm.folder = a->db.FileToFolder[i] == (UInt32)-1 ? -1 : (int)a->db.FileToFolder[i];
+		if (!add_member(a, &mm)) {
+			fail(err, errlen, "it has too many files");
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static void choose_game(struct arc *a)
+{
+	static const char *const prio[] = { ".m3u", ".cue", ".ccd", ".mds", ".toc", ".chd", ".pbp",
+	                                    ".iso", ".img", ".bin", ".exe", ".psx", NULL };
+	int p, i;
+	a->game = -1;
+	for (p = 0; prio[p] && a->game < 0; p++)
+		for (i = 0; i < a->n; i++)
+			if (!a->m[i].is_dir && !strcasecmp(extof(a->m[i].name), prio[p]) &&
+			    (a->game < 0 || strcasecmp(a->m[i].name, a->m[a->game].name) < 0))
+				a->game = i;
+}
+
+struct arc *arc_open(const char *path, char *err, int errlen)
+{
+	struct arc *a = calloc(1, sizeof *a);
+	long fsize;
+	int i, ok;
+	if (err && errlen)
+		err[0] = 0;
+	if (a == NULL) {
+		fail(err, errlen, "there isn't enough memory");
+		return NULL;
+	}
+	a->mi = -1;
+	a->type = arc_type(path);
+	if (a->type == ARC_NONE || (a->f = fopen(path, "rb")) == NULL) {
+		fail(err, errlen, a->type == ARC_NONE ? "it isn't a zip or 7z file" : "it couldn't be opened");
+		free(a);
+		return NULL;
+	}
+	if (fseek(a->f, 0, SEEK_END) || (fsize = ftell(a->f)) < 0) {
+		fail(err, errlen, "it's too big for PCSX");
+		arc_close(a);
+		return NULL;
+	}
+	rewind(a->f);
+	ok = a->type == ARC_ZIP ? zip_open(a, fsize, err, errlen) : sz_open(a, err, errlen);
+	if (!ok) {
+		arc_close(a);
+		return NULL;
+	}
+	for (i = 0; i < a->n; i++) {
+		arc_disc_name(a->m[i].name, a->m[i].out, sizeof a->m[i].out);
+		if (!a->m[i].out[0])
+			snprintf(a->m[i].out, sizeof a->m[i].out, "file%d", i);
+		if (!a->m[i].is_dir)
+			a->total += a->m[i].size;
+	}
+	choose_game(a);
+	return a;
+}
+
+const char *arc_game(const struct arc *a)
+{
+	return a && a->game >= 0 ? a->m[a->game].name : NULL;
+}
+
+double arc_total(const struct arc *a) { return a ? (double)a->total : 0; }
+int arc_count(const struct arc *a) { return a ? a->n : 0; }
+
+const char *arc_name(const struct arc *a, int i)
+{
+	return a && i >= 0 && i < a->n && !a->m[i].is_dir ? a->m[i].name : NULL;
+}
+
+int arc_percent(const struct arc *a)
+{
+	if (a == NULL || a->total == 0)
+		return a && a->started ? 100 : 0;
+	return (int)(a->done * 100 / a->total);
+}
+
+const char *arc_game_path(const struct arc *a) { return a ? a->game_path : ""; }
+
+/* ---- decoding one stream ---- */
+
+static void dec_end(struct arc *a)
+{
+	if (a->zs_live)
+		mz_inflateEnd(&a->zs);
+	if (a->lz_live)
+		LzmaDec_Free(&a->lz, &g_alloc);
+	if (a->lz2_live)
+		Lzma2Dec_Free(&a->lz2, &g_alloc);
+	free(a->mem);
+	a->mem = NULL;
+	a->zs_live = a->lz_live = a->lz2_live = 0;
+	a->coder = C_NONE;
+}
+
+static unsigned lzma2_dict(unsigned p)
+{
+	return p >= 40 ? 0xFFFFFFFFu : (2u | (p & 1)) << (p / 2 + 11);
+}
+
+static int dec_start(struct arc *a, int coder, u64 pos, u64 pack, u64 unpack,
+                     const unsigned char *props, unsigned nprops, char *err, int errlen)
+{
+	SRes r = SZ_OK;
+	dec_end(a);
+	if (a->in == NULL && (a->in = malloc(INBUF)) == NULL) {
+		fail(err, errlen, "there isn't enough memory");
+		return 0;
+	}
+	a->coder = coder;
+	a->pack_left = pack;
+	a->unpack_left = unpack;
+	a->in_pos = a->in_len = 0;
+	if (coder != C_MEM && fseek(a->f, (long)pos, SEEK_SET)) {
+		fail(err, errlen, "the archive couldn't be read");
+		return 0;
+	}
+	switch (coder) {
+	case C_DEFLATE:
+		memset(&a->zs, 0, sizeof a->zs);
+		if (mz_inflateInit2(&a->zs, -MZ_DEFAULT_WINDOW_BITS) != MZ_OK) {
+			fail(err, errlen, "there isn't enough memory");
+			return 0;
+		}
+		a->zs_live = 1;
+		break;
+	case C_LZMA:
+		LzmaDec_Construct(&a->lz);
+		r = nprops >= 5 ? LzmaDec_Allocate(&a->lz, props, nprops, &g_alloc) : SZ_ERROR_UNSUPPORTED;
+		if (r == SZ_OK) {
+			LzmaDec_Init(&a->lz);
+			a->lz_live = 1;
+		}
+		break;
+	case C_LZMA2:
+		Lzma2Dec_Construct(&a->lz2);
+		r = nprops >= 1 ? Lzma2Dec_Allocate(&a->lz2, props[0], &g_alloc) : SZ_ERROR_UNSUPPORTED;
+		if (r == SZ_OK) {
+			Lzma2Dec_Init(&a->lz2);
+			a->lz2_live = 1;
+		}
+		break;
+	}
+	if (r == SZ_ERROR_MEM) {
+		unsigned d = coder == C_LZMA ? g32(props + 1) : lzma2_dict(props[0]);
+		fail(err, errlen, "unpacking it needs %u MB of memory, more than PCSX can have",
+		     (d >> 20) + 1);
+		return 0;
+	}
+	if (r != SZ_OK) {
+		fail(err, errlen, "it uses settings PCSX can't unpack");
+		return 0;
+	}
+	return 1;
+}
+
+static int fill(struct arc *a)
+{
+	size_t want, got;
+	if (a->in_pos < a->in_len)
+		return 1;
+	if (a->pack_left == 0)
+		return 0;
+	want = a->pack_left < INBUF ? (size_t)a->pack_left : INBUF;
+	got = fread(a->in, 1, want, a->f);
+	if (got == 0)
+		return -1;
+	a->in_pos = 0;
+	a->in_len = got;
+	a->pack_left -= got;
+	return 1;
+}
+
+/* Up to MAX bytes of the stream: how many (> 0), or -1. */
+static long dec_read(struct arc *a, unsigned char *out, size_t max, char *err, int errlen)
+{
+	size_t want = max;
+	if (a->unpack_left < want)
+		want = (size_t)a->unpack_left;
+	if (want == 0)
+		return 0;
+	for (;;) {
+		int fr = a->coder == C_MEM ? 0 : fill(a);
+		size_t avail;
+		if (fr < 0) {
+			fail(err, errlen, "the archive couldn't be read");
+			return -1;
+		}
+		avail = a->in_len - a->in_pos;
+		switch (a->coder) {
+		case C_COPY: {
+			size_t n = avail < want ? avail : want;
+			if (n == 0)
+				goto early;
+			memcpy(out, a->in + a->in_pos, n);
+			a->in_pos += n;
+			a->unpack_left -= n;
+			return (long)n;
+		}
+		case C_MEM: {
+			size_t n = a->mem_len - a->mem_pos;
+			if (n > want)
+				n = want;
+			if (n == 0)
+				goto early;
+			memcpy(out, a->mem + a->mem_pos, n);
+			a->mem_pos += n;
+			a->unpack_left -= n;
+			return (long)n;
+		}
+		case C_DEFLATE: {
+			int r;
+			size_t n;
+			a->zs.next_in = a->in + a->in_pos;
+			a->zs.avail_in = (unsigned)avail;
+			a->zs.next_out = out;
+			a->zs.avail_out = (unsigned)want;
+			r = mz_inflate(&a->zs, MZ_NO_FLUSH);
+			a->in_pos = a->in_len - a->zs.avail_in;
+			n = want - a->zs.avail_out;
+			if (r != MZ_OK && r != MZ_STREAM_END && r != MZ_BUF_ERROR)
+				goto damaged;
+			if (n) {
+				a->unpack_left -= n;
+				return (long)n;
+			}
+			if (r == MZ_STREAM_END || (fr == 0 && avail == 0))
+				goto early;
+			if (avail && a->zs.avail_in == avail)
+				goto damaged;
+			break;
+		}
+		case C_LZMA:
+		case C_LZMA2: {
+			SizeT ol = want, il = avail;
+			ELzmaStatus st;
+			SRes r = a->coder == C_LZMA ?
+				LzmaDec_DecodeToBuf(&a->lz, out, &ol, a->in + a->in_pos, &il, LZMA_FINISH_ANY, &st) :
+				Lzma2Dec_DecodeToBuf(&a->lz2, out, &ol, a->in + a->in_pos, &il, LZMA_FINISH_ANY, &st);
+			a->in_pos += il;
+			if (r != SZ_OK)
+				goto damaged;
+			if (ol) {
+				a->unpack_left -= ol;
+				return (long)ol;
+			}
+			if (st == LZMA_STATUS_FINISHED_WITH_MARK || (fr == 0 && avail == 0))
+				goto early;
+			if (avail && il == 0)
+				goto damaged;
+			break;
+		}
+		default:
+			goto damaged;
+		}
+	}
+early:
+	fail(err, errlen, "the archive ends early, or is damaged");
+	return -1;
+damaged:
+	fail(err, errlen, "the archive is damaged");
+	return -1;
+}
+
+/* zip: the stream of member I */
+static int zip_stream(struct arc *a, int i, char *err, int errlen)
+{
+	struct member *mm = &a->m[i];
+	unsigned char h[30];
+	u64 pos;
+	if (mm->flags & 1) {
+		fail(err, errlen, "%s is encrypted", leafof(mm->name));
+		return 0;
+	}
+	if (fseek(a->f, (long)mm->lh_off, SEEK_SET) || fread(h, 1, 30, a->f) != 30 ||
+	    memcmp(h, "PK\3\4", 4)) {
+		fail(err, errlen, "the archive is damaged (at %s)", leafof(mm->name));
+		return 0;
+	}
+	pos = mm->lh_off + 30 + g16(h + 26) + g16(h + 28);
+	switch (mm->method) {
+	case 0:
+		return dec_start(a, C_COPY, pos, mm->csize, mm->size, NULL, 0, err, errlen);
+	case 8:
+		return dec_start(a, C_DEFLATE, pos, mm->csize, mm->size, NULL, 0, err, errlen);
+	case 14: {
+		unsigned char p[9];
+		if (mm->csize < 9 || fseek(a->f, (long)pos, SEEK_SET) || fread(p, 1, 9, a->f) != 9 ||
+		    g16(p + 2) != 5) {
+			fail(err, errlen, "the archive is damaged (at %s)", leafof(mm->name));
+			return 0;
+		}
+		return dec_start(a, C_LZMA, pos + 9, mm->csize - 9, mm->size, p + 4, 5, err, errlen);
+	}
+	}
+	fail(err, errlen, "%s is packed in a way PCSX can't unpack (zip method %d)",
+	     leafof(mm->name), mm->method);
+	return 0;
+}
+
+/* 7z: the stream of block F */
+static int sz_folder_stream(struct arc *a, int f, char *err, int errlen)
+{
+	const CSzAr *p = &a->db.db;
+	const Byte *data = p->CodersData + p->FoCodersOffsets[f];
+	CSzData sd;
+	CSzFolder fo;
+	u64 unpack = SzAr_GetFolderUnpackSize(p, f);
+	UInt32 ps = p->FoStartPackStreamIndex[f];
+	u64 pos = a->db.dataPos + p->PackPositions[ps];
+	u64 pack = p->PackPositions[ps + 1] - p->PackPositions[ps];
+	sd.Data = data;
+	sd.Size = p->FoCodersOffsets[f + 1] - p->FoCodersOffsets[f];
+	if (SzGetNextFolderItem(&fo, &sd) != SZ_OK) {
+		fail(err, errlen, "the archive is damaged");
+		return 0;
+	}
+	if (fo.NumCoders == 1 && fo.NumPackStreams == 1 && fo.NumBonds == 0) {
+		const CSzCoderInfo *c = &fo.Coders[0];
+		const Byte *pr = data + c->PropsOffset;
+		switch (c->MethodID) {
+		case 0:
+			return dec_start(a, C_COPY, pos, pack, unpack, NULL, 0, err, errlen);
+		case 0x30101:
+			return dec_start(a, C_LZMA, pos, pack, unpack, pr, c->PropsSize, err, errlen);
+		case 0x21:
+			return dec_start(a, C_LZMA2, pos, pack, unpack, pr, c->PropsSize, err, errlen);
+		}
+	}
+	/* anything else (filters, PPMd...): the SDK's decoder, in memory */
+	if (unpack <= ARC_MEM_FOLDER) {
+		SRes r;
+		if (!dec_start(a, C_MEM, 0, 0, unpack, NULL, 0, err, errlen))
+			return 0;
+		if ((a->mem = malloc(unpack ? (size_t)unpack : 1)) == NULL) {
+			fail(err, errlen, "there isn't enough memory");
+			return 0;
+		}
+		r = SzAr_DecodeFolder(p, f, &a->look.vt, a->db.dataPos, a->mem, (size_t)unpack, &g_alloc);
+		if (r != SZ_OK) {
+			fail(err, errlen, r == SZ_ERROR_UNSUPPORTED ?
+			     "it's packed in a way PCSX can't unpack (encrypted?)" :
+			     r == SZ_ERROR_MEM ? "there isn't enough memory" : "the archive is damaged");
+			return 0;
+		}
+		a->mem_pos = 0;
+		a->mem_len = (size_t)unpack;
+		return 1;
+	}
+	fail(err, errlen, "it's packed in a way PCSX can't unpack: pack it again with 7-Zip's "
+	     "usual settings (LZMA2), or as a zip");
+	return 0;
+}
+
+/* ---- writing members ---- */
+
+static void make_dirs(const char *path, int last_too)
+{
+	char p[1100];
+	char *s;
+	snprintf(p, sizeof p, "%s", path);
+	for (s = p + 1; *s; s++)
+		if (*s == '/') {
+			*s = 0;
+			mkdir(p, 0777);
+			*s = '/';
+		}
+	if (last_too)
+		mkdir(p, 0777);
+}
+
+static int is_text_member(const struct member *mm)
+{
+	const char *e = extof(mm->name);
+	return mm->size <= TEXT_MAX && (!strcasecmp(e, ".cue") || !strcasecmp(e, ".m3u"));
+}
+
+/* A .cue's FILE names and an .m3u's lines, as the files were written. */
+static void rewrite_text(const unsigned char *t, size_t n, int m3u, FILE *o)
+{
+	size_t i = 0;
+	while (i < n) {
+		size_t e = i, end;
+		char line[1100], fixed[1100];
+		int ll;
+		while (e < n && t[e] != '\n' && t[e] != '\r')
+			e++;
+		end = e;
+		if (end < n && t[end] == '\r')
+			end++;
+		if (end < n && t[end] == '\n')
+			end++;
+		ll = (int)(e - i) < (int)sizeof line - 1 ? (int)(e - i) : (int)sizeof line - 1;
+		memcpy(line, t + i, ll);
+		line[ll] = 0;
+		if (m3u) {
+			const char *s = line + strspn(line, " \t");
+			if (*s && *s != '#') {
+				arc_disc_name(s, fixed, sizeof fixed);
+				fprintf(o, "%.*s%s", (int)(s - line), line, fixed);
+			} else
+				fputs(line, o);
+		} else {
+			const char *s = line + strspn(line, " \t");
+			if (!strncasecmp(s, "FILE", 4) && (s[4] == ' ' || s[4] == '\t')) {
+				const char *q = s + 4 + strspn(s + 4, " \t"), *qe;
+				char name[600];
+				int quoted = *q == '"';
+				if (quoted) {
+					q++;
+					qe = strchr(q, '"');
+					if (qe == NULL)
+						qe = q + strlen(q);
+				} else
+					qe = q + strcspn(q, " \t");
+				snprintf(name, sizeof name, "%.*s", (int)(qe - q), q);
+				arc_disc_name(name, fixed, sizeof fixed);
+				fprintf(o, "%.*s%s%s%s", (int)(q - line), line, fixed, quoted ? "\"" : "",
+				        quoted && *qe ? qe + 1 : qe);
+			} else
+				fputs(line, o);
+		}
+		fwrite(t + e, 1, end - e, o);
+		i = end;
+	}
+}
+
+static int member_end(struct arc *a, char *err, int errlen)
+{
+	struct member *mm = &a->m[a->mi];
+	char p[1100];
+	int ok = 1;
+	snprintf(p, sizeof p, "%s/%s", a->dir, mm->out);
+	if (mm->has_crc && a->crc_run != mm->crc) {
+		fail(err, errlen, "%s is damaged in the archive (its CRC is wrong)", leafof(mm->name));
+		ok = 0;
+	}
+	if (a->text) {
+		FILE *o = ok ? fopen(p, "wb") : NULL;
+		if (ok && o == NULL) {
+			fail(err, errlen, "%s couldn't be written", p);
+			ok = 0;
+		}
+		if (o) {
+			rewrite_text(a->text, a->text_len, !strcasecmp(extof(mm->name), ".m3u"), o);
+			if (fclose(o) != 0) {
+				fail(err, errlen, "%s couldn't be written: is the disc full?", p);
+				ok = 0;
+			}
+		}
+		free(a->text);
+		a->text = NULL;
+	} else if (a->out) {
+		if (fclose(a->out) != 0 && ok) {
+			fail(err, errlen, "%s couldn't be written: is the disc full?", p);
+			ok = 0;
+		}
+		a->out = NULL;
+	}
+	a->mi = -1;
+	return ok;
+}
+
+static int member_begin(struct arc *a, int i, char *err, int errlen)
+{
+	struct member *mm = &a->m[i];
+	char p[1100];
+	snprintf(p, sizeof p, "%s/%s", a->dir, mm->out);
+	make_dirs(p, 0);
+	a->mi = i;
+	a->out_left = mm->size;
+	a->crc_run = 0;
+	a->text_len = 0;
+	a->text = NULL;
+	a->out = NULL;
+	if (is_text_member(mm))
+		a->text = malloc(mm->size ? (size_t)mm->size : 1);
+	if (a->text == NULL && (a->out = fopen(p, "wb")) == NULL) {
+		fail(err, errlen, "%s couldn't be created", p);
+		a->mi = -1;
+		return 0;
+	}
+	if (mm->size == 0)
+		return member_end(a, err, errlen);
+	return 1;
+}
+
+static int member_write(struct arc *a, const unsigned char *b, size_t n, char *err, int errlen)
+{
+	a->crc_run = (unsigned)mz_crc32(a->crc_run, b, n);
+	if (a->text) {
+		memcpy(a->text + a->text_len, b, n);
+		a->text_len += n;
+	} else if (fwrite(b, 1, n, a->out) != n) {
+		fail(err, errlen, "%s/%s couldn't be written: is the disc full?", a->dir, a->m[a->mi].out);
+		return 0;
+	}
+	a->out_left -= n;
+	a->done += n;
+	if (a->out_left == 0)
+		return member_end(a, err, errlen);
+	return 1;
+}
+
+/* ---- unpacking ---- */
+
+int arc_unpack_start(struct arc *a, const char *dir, char *err, int errlen)
+{
+	if (err && errlen)
+		err[0] = 0;
+	snprintf(a->dir, sizeof a->dir, "%s", dir);
+	while (strlen(a->dir) > 1 && a->dir[strlen(a->dir) - 1] == '/')
+		a->dir[strlen(a->dir) - 1] = 0;
+	make_dirs(a->dir, 1);
+	if ((a->buf == NULL && (a->buf = malloc(OUTBUF)) == NULL)) {
+		fail(err, errlen, "there isn't enough memory");
+		return 0;
+	}
+	a->started = 1;
+	a->phase = 0;
+	a->cur = 0;
+	a->mi = -1;
+	a->done = 0;
+	if (a->game >= 0)
+		snprintf(a->game_path, sizeof a->game_path, "%s/%s", a->dir, a->m[a->game].out);
+	else
+		a->game_path[0] = 0;
+	return 1;
+}
+
+static int write_some(struct arc *a, char *err, int errlen)
+{
+	size_t want = a->out_left < OUTBUF ? (size_t)a->out_left : OUTBUF;
+	long n = dec_read(a, a->buf, want, err, errlen);
+	if (n < 0)
+		return -1;
+	return member_write(a, a->buf, (size_t)n, err, errlen) ? 1 : -1;
+}
+
+static int zip_step(struct arc *a, char *err, int errlen)
+{
+	while (a->mi < 0) {
+		struct member *mm;
+		if (a->cur >= a->n) {
+			dec_end(a);
+			return 0;
+		}
+		mm = &a->m[a->cur];
+		if (mm->is_dir) {
+			char p[1100];
+			snprintf(p, sizeof p, "%s/%s", a->dir, mm->out);
+			make_dirs(p, 1);
+			a->cur++;
+			continue;
+		}
+		if (!zip_stream(a, a->cur, err, errlen) || !member_begin(a, a->cur, err, errlen))
+			return -1;
+		if (a->mi < 0)
+			a->cur++;          /* empty */
+	}
+	if (write_some(a, err, errlen) < 0)
+		return -1;
+	if (a->mi < 0)
+		a->cur++;
+	return 1;
+}
+
+static int sz_step(struct arc *a, char *err, int errlen)
+{
+	if (a->phase == 0) {
+		/* folders and empty files first */
+		int i;
+		for (i = 0; i < a->n; i++) {
+			struct member *mm = &a->m[i];
+			if (mm->is_dir) {
+				char p[1100];
+				snprintf(p, sizeof p, "%s/%s", a->dir, mm->out);
+				make_dirs(p, 1);
+			} else if (mm->folder < 0 && !member_begin(a, i, err, errlen))
+				return -1;
+		}
+		a->phase = 1;
+		a->cur = 0;
+		a->folder_live = 0;
+		return 1;
+	}
+	while (a->mi < 0) {
+		if (a->folder_live) {
+			while (a->file_i < a->n && a->m[a->file_i].folder != a->cur)
+				a->file_i++;
