--- /dev/null
+++ b/frontend/riscos/archive.h
@@ -0,0 +1,53 @@
+/*
+ * Games in .zip and .7z archives: unpacked into a scratch folder, a piece
+ * at a time (so the desktop keeps running), played from there, and
+ * deleted afterwards. Portable C (stdio): the Linux tests run it too.
+ *
+ *   zip: stored, deflate, LZMA; zip64.
+ *   7z:  LZMA, LZMA2 and copy, streamed (any size); other methods and
+ *        filters (BCJ etc.) only in blocks small enough to unpack in
+ *        memory (ARC_MEM_FOLDER).
+ *
+ * Copyright (C) 2026 Andrew Youll. GPL-2.0-or-later, as PCSX ReARMed.
+ */
+#ifndef ARCHIVE_H
+#define ARCHIVE_H
+
+enum { ARC_NONE, ARC_ZIP, ARC_7Z };
+#define ARC_MEM_FOLDER (8u << 20)   /* decoded in one go: kept small, it blocks */
+
+/* What a file is, from its first bytes (not its name). */
+int arc_type(const char *path);
+/* From the name alone: .zip or .7z (for scanning folders quickly). */
+int arc_ext(const char *path);
+
+struct arc;
+struct arc *arc_open(const char *path, char *err, int errlen);
+void arc_close(struct arc *a);
+/* The member chosen to play (.m3u, .cue, .chd, .pbp, .iso...), as stored;
+   NULL if there's none. */
+const char *arc_game(const struct arc *a);
+double arc_total(const struct arc *a);         /* bytes it unpacks to */
+int arc_count(const struct arc *a);            /* members (folders too) */
+const char *arc_name(const struct arc *a, int i);   /* NULL for a folder */
+
+/* Unpacking: start into DIR (made if need be), then step until 0 (done)
+   or -1 (failed: ERR says why). Each step unpacks about a megabyte. */
+int arc_unpack_start(struct arc *a, const char *dir, char *err, int errlen);
+int arc_unpack_step(struct arc *a, char *err, int errlen);
+int arc_percent(const struct arc *a);
+const char *arc_game_path(const struct arc *a);   /* the unpacked game file */
+
+/* The first MAX bytes of a member (matched by name, case ignored, with or
+   without its folder), into BUF: the bytes read, or -1. *SIZE, if not
+   NULL, gets the member's full size. */
+long arc_read(struct arc *a, const char *name, unsigned char *buf, long max, double *size);
+
+/* Deletes everything inside DIR (DIR stays). */
+void arc_clear_dir(const char *dir);
+
+/* A member name as it's written to disc (no characters RISC OS can't
+   have in a file name; spaces kept as hard spaces on RISC OS). */
+void arc_disc_name(const char *name, char *out, int len);
+
+#endif
