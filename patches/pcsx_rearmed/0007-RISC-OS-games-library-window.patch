+int ui_screen_h(void);
+void ui_report(const char *msg);
+void ui_play(const char *unix_path);   /* load (with its settings) and show */
+void ui_start_task(const char *cmd);
+void ui_menu_is_libwin(void);          /* the menu just opened is libwin's */
+
+/* libwin.c */
+void libwin_init(void);
+void libwin_open(void);
+int libwin_window(void);
+void libwin_redraw(int *block);
+void libwin_open_request(int *block);
+void libwin_click(int *block);
+int libwin_key(int code);              /* 1 if it was ours */
+void libwin_menu_select(const int *sel);
+void libwin_menu_rebuild(void);        /* for Adjust-clicks */
+void *libwin_menu(void);               /* the menu tree's top, for reopening */
+/* a file or folder dropped on PCSX: 1 if the library took it (a folder) */
+int libwin_dataload(const char *ro_path, int filetype);
+/* the settings file to layer over Choices for this game (or "") */
+void libwin_settings_file(const char *unix_path, char *buf, int len);
+void libwin_played(const char *unix_path, const char *serial);
+void libwin_mode_changed(void);
+
+#endif
