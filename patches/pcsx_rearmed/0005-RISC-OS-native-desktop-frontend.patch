diff --git a/frontend/riscos/choices.c b/frontend/riscos/choices.c
new file mode 100644
index 00000000..0408ab79
--- /dev/null
+++ b/frontend/riscos/choices.c
@@ -0,0 +1,93 @@
+/*
+ * The Choices file: one setting per line, "key: value" (or "key = value").
+ * Blank lines and lines starting with # are ignored. Later lines win.
+ *
+ * Copyright (C) 2026 Andrew Youll. GPL-2.0-or-later, as PCSX ReARMed.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include "rofe.h"
+
+#define MAX_CHOICES 256
+
+static struct { char key[64]; char value[128]; } ch[MAX_CHOICES];
+static int nch;
+
+void choices_clear(void)
+{
+	nch = 0;
+}
+
+static char *trim(char *s)
+{
+	char *e;
+	while (*s && isspace((unsigned char)*s))
+		s++;
+	e = s + strlen(s);
+	while (e > s && isspace((unsigned char)e[-1]))
+		*--e = 0;
+	return s;
+}
+
+void choices_set(const char *key, const char *value)
+{
+	int i;
+	for (i = 0; i < nch; i++)
+		if (strcasecmp(ch[i].key, key) == 0)
+			break;
+	if (i == nch) {
+		if (nch == MAX_CHOICES)
+			return;
+		nch++;
+	}
+	snprintf(ch[i].key, sizeof ch[i].key, "%s", key);
+	snprintf(ch[i].value, sizeof ch[i].value, "%s", value);
+}
+
+int choices_load(const char *path)
+{
+	char line[256];
+	FILE *f = fopen(path, "r");
+	if (f == NULL)
+		return 0;
+	while (fgets(line, sizeof line, f)) {
+		char *s = trim(line), *sep;
+		if (*s == 0 || *s == '#')
+			continue;
+		sep = strpbrk(s, ":=");
+		if (sep == NULL)
+			continue;
+		*sep = 0;
+		choices_set(trim(s), trim(sep + 1));
+	}
+	fclose(f);
+	return 1;
+}
+
+const char *choices_get(const char *key)
+{
+	int i;
+	for (i = nch - 1; i >= 0; i--)
+		if (strcasecmp(ch[i].key, key) == 0)
+			return ch[i].value;
+	return NULL;
+}
+
+int choices_get_int(const char *key, int def)
+{
+	const char *v = choices_get(key);
+	char *end;
+	long n;
+	if (v == NULL || *v == 0)
+		return def;
+	if (strcasecmp(v, "yes") == 0 || strcasecmp(v, "on") == 0 ||
+	    strcasecmp(v, "enabled") == 0 || strcasecmp(v, "true") == 0)
+		return 1;
+	if (strcasecmp(v, "no") == 0 || strcasecmp(v, "off") == 0 ||
+	    strcasecmp(v, "disabled") == 0 || strcasecmp(v, "false") == 0)
+		return 0;
+	n = strtol(v, &end, 0);
+	return end == v ? def : (int)n;
+}
diff --git a/frontend/riscos/host.c b/frontend/riscos/host.c
new file mode 100644
index 00000000..f5b45ea9
--- /dev/null
+++ b/frontend/riscos/host.c
@@ -0,0 +1,825 @@
+/*
+ * The libretro host for !PCSX: everything between the core
+ * (frontend/libretro.c) and the desktop (wimp.c).
+ *
+ * - Core options: the core declares them (RETRO_ENVIRONMENT_SET_VARIABLES,
+ *   "Description; default|other|..."). The value used is the Choices
+ *   file's, if it names a value the option has, else this frontend's
+ *   default (fe_defaults below), else the core's.
+ * - Video: the core draws straight into the frontend's buffer (the image
+ *   of a RISC OS 32bpp sprite) through GET_CURRENT_SOFTWARE_FRAMEBUFFER.
+ * - Sound: each frame's samples are queued with plat_audio_write.
+ * - Input: keyboard (only while we have the input focus) and joysticks,
+ *   both mapped by Choices.
+ *
+ * Copyright (C) 2026 Andrew Youll. GPL-2.0-or-later, as PCSX ReARMed.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <stdarg.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include "libretro.h"
+#include "rofe.h"
+
+/* ------------------------------------------------------------------ */
+/* Core options                                                        */
+
+#define MAX_OPTS 160
+
+struct opt {
+	char key[64];
+	char *values;            /* "a|b|c", malloc'ed */
+	char value[64];          /* the one in use */
+};
+static struct opt opts[MAX_OPTS];
+static int nopts;
+static int opts_changed;
+
+/* This frontend's defaults, where the core's don't suit RISC OS. */
+static const char *const fe_defaults[][2] = {
+	{ "pcsx_rearmed_rgb32_output", "enabled" },   /* required: 32bpp sprite */
+	{ "pcsx_rearmed_memcard1", "shared" },        /* one card for all games */
+	{ "pcsx_rearmed_drc", "enabled" },
+	{ "pcsx_rearmed_frameskip_type", "disabled" },
+	{ NULL, NULL }
+};
+/* Options the frontend depends on: Choices can't change them. */
+static const char *const fe_forced[][2] = {
+	{ "pcsx_rearmed_rgb32_output", "enabled" },
+	{ "pcsx_rearmed_scale_hires", "disabled" },
+	{ "pcsx_rearmed_drc_thread", "disabled" },
+	{ "pcsx_rearmed_spu_thread", "disabled" },
+	{ "pcsx_rearmed_gpu_thread_rendering", "disabled" },
+	{ NULL, NULL }
+};
+
+static int value_allowed(const struct opt *o, const char *v)
+{
+	const char *p = o->values;
+	size_t n = strlen(v);
+	if (n == 0)
+		return 0;
+	while (p && *p) {
+		const char *e = strchr(p, '|');
+		size_t len = e ? (size_t)(e - p) : strlen(p);
+		if (len == n && strncasecmp(p, v, n) == 0)
+			return 1;
+		p = e ? e + 1 : NULL;
+	}
+	return 0;
+}
+
+static const char *table_get(const char *const t[][2], const char *key)
+{
+	int i;
+	for (i = 0; t[i][0]; i++)
+		if (strcmp(t[i][0], key) == 0)
+			return t[i][1];
+	return NULL;
+}
+
+/* Work out every option's value; note whether any changed. */
+static void opts_resolve(void)
+{
+	int i;
+	for (i = 0; i < nopts; i++) {
+		struct opt *o = &opts[i];
+		const char *v = table_get(fe_forced, o->key);
+		char old[64];
+		strcpy(old, o->value);
+		if (v == NULL || !value_allowed(o, v)) {
+			v = choices_get(o->key);
+			if (v && !value_allowed(o, v)) {
+				plat_log("Choices: %s: \"%s\" isn't one of %s\n", o->key, v, o->values);
+				v = NULL;
+			}
+		}
+		if (v == NULL) {
+			v = table_get(fe_defaults, o->key);
+			if (v && !value_allowed(o, v))
+				v = NULL;
+		}
+		if (v == NULL) {           /* the core's default: the first value */
+			const char *e = strchr(o->values, '|');
+			size_t len = e ? (size_t)(e - o->values) : strlen(o->values);
+			if (len >= sizeof o->value)
+				len = sizeof o->value - 1;
+			memcpy(o->value, o->values, len);
+			o->value[len] = 0;
+		} else
+			snprintf(o->value, sizeof o->value, "%s", v);
+		if (strcmp(old, o->value) != 0)
+			opts_changed = 1;
+	}
+}
+
+static void opts_set_variables(const struct retro_variable *vars)
+{
+	for (; vars->key && nopts < MAX_OPTS; vars++) {
+		const char *semi = strchr(vars->value, ';');
+		struct opt *o = &opts[nopts];
+		const char *list = semi ? semi + 1 : vars->value;
+		while (*list == ' ')
+			list++;
+		snprintf(o->key, sizeof o->key, "%s", vars->key);
+		o->values = strdup(list);
+		o->value[0] = 0;
+		if (o->values)
+			nopts++;
+	}
+	opts_resolve();
+	opts_changed = 0;
+}
+
+static const char *opt_get(const char *key)
+{
+	int i;
+	for (i = 0; i < nopts; i++)
+		if (strcmp(opts[i].key, key) == 0)
+			return opts[i].value;
+	return NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* State                                                               */
+
+static char sys_dir[512], save_dir[512], state_dir[512];
+static host_fb_func fb_func;
+static int game_loaded;
+static char game_name[128];
+static struct retro_system_av_info av;
+static struct host_video frame;
+static int new_frame;
+static char message[128];
+static unsigned message_until;
+
+static int16_t audio_buf[44100 / 25 * 2 * 2];   /* > one frame of stereo */
+static int audio_frames;
+static int audio_open;
+
+/* Input */
+#define NBUTTONS 16
+static const char *const button_names[NBUTTONS] = {
+	"cross", "square", "select", "start", "up", "down", "left", "right",
+	"circle", "triangle", "l1", "r1", "l2", "r2", "l3", "r3"
+};
+/* libretro joypad ids, in the order above: B Y SELECT START UP DOWN LEFT
+   RIGHT A X L R L2 R2 L3 R3 = 0..15, which is the order of the names. */
+static const char *const default_keys[NBUTTONS] = {
+	"Z", "A", "RShift", "Return", "Up", "Down", "Left", "Right",
+	"X", "S", "Q", "W", "1", "2", "3", "4"
+};
+static int keymap[ROFE_MAX_PADS][NBUTTONS];       /* INKEY code or -1 */
+/* joystick button n -> psx button (index above), or -1 */
+static int joymap[JOY_MAX_BUTTONS];
+static int joy_deadzone;
+static int analog_sticks;                         /* send sticks to the core */
+static uint16_t pad_bits[ROFE_MAX_PADS];
+static int16_t pad_analog[ROFE_MAX_PADS][2][2];   /* [stick][x/y] */
+static int joy_log;
+static uint32_t joy_last_buttons[ROFE_MAX_PADS];
+
+static unsigned pad_device[ROFE_MAX_PADS];
+
+unsigned host_pad_bits(int port)
+{
+	return port >= 0 && port < ROFE_MAX_PADS ? pad_bits[port] : 0;
+}
+
+int host_pad_analog(int port, int stick, int axis)
+{
+	return port >= 0 && port < ROFE_MAX_PADS && stick >= 0 && stick < 2 && axis >= 0 && axis < 2 ?
+	       pad_analog[port][stick][axis] : 0;
+}
+
+int host_setting_int(const char *key, int def)
+{
+	return choices_get_int(key, def);
+}
+
+static void load_input_map(void)
+{
+	int p, b;
+	static const char *const default_joy =
+		"0=cross 1=circle 2=square 3=triangle 4=l1 5=r1 6=l2 7=r2 "
+		"8=select 9=start 10=l3 11=r3";
+	const char *jm;
+	char key[48];
+
+	for (p = 0; p < ROFE_MAX_PADS; p++)
+		for (b = 0; b < NBUTTONS; b++) {
+			const char *name;
+			snprintf(key, sizeof key, "pad%d.%s", p + 1, button_names[b]);
+			name = choices_get(key);
+			if (name == NULL && p == 0)
+				name = default_keys[b];
+			keymap[p][b] = keys_lookup(name);
+			if (name && keymap[p][b] < 0 && strcasecmp(name, "none") != 0)
+				plat_log("Choices: %s: no key called \"%s\"\n", key, name);
+		}
+
+	for (b = 0; b < JOY_MAX_BUTTONS; b++)
+		joymap[b] = -1;
+	jm = choices_get("joy.buttons");
+	if (jm == NULL)
+		jm = default_joy;
+	while (*jm) {
+		char *end;
+		long n = strtol(jm, &end, 10);
+		if (end != jm && *end == '=') {
+			const char *nm = end + 1;
+			size_t len = strcspn(nm, " ,");
+			for (b = 0; b < NBUTTONS; b++)
+				if (strlen(button_names[b]) == len &&
+				    strncasecmp(button_names[b], nm, len) == 0)
+					break;
+			if (n >= 0 && n < JOY_MAX_BUTTONS && b < NBUTTONS)
+				joymap[n] = b;
+			else
+				plat_log("Choices: joy.buttons: can't use \"%.*s\"\n",
+				         (int)(len + (nm - jm)), jm);
+			jm = nm + len;
+		} else
+			jm = end != jm ? end : jm + 1;
+		while (*jm == ' ' || *jm == ',')
+			jm++;
+	}
+	joy_deadzone = choices_get_int("joy.deadzone", 25);   /* percent */
+	if (joy_deadzone < 0 || joy_deadzone > 90)
+		joy_deadzone = 25;
+	joy_log = choices_get_int("joy.log", 0);
+}
+
+static unsigned pad_type_from_choices(int p)
+{
+	char key[32];
+	const char *t;
+	snprintf(key, sizeof key, "pad%d.type", p + 1);
+	t = choices_get(key);
+	if (t && strcasecmp(t, "analog") == 0)
+		return RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_ANALOG, 0);
+	if (t && strcasecmp(t, "dualshock") == 0)
+		return RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_ANALOG, 1);
+	if (t && strcasecmp(t, "none") == 0)
+		return RETRO_DEVICE_NONE;
+	if (t && strcasecmp(t, "standard") != 0)
+		plat_log("Choices: %s: use standard, analog, dualshock or none\n", key);
+	return RETRO_DEVICE_JOYPAD;
+}
+
+static int deadzoned(int v)
+{
+	int dz = 32767 * joy_deadzone / 100;
+	if (v > -dz && v < dz)
+		return 0;
+	return v;
+}
+
+static void poll_input(int have_focus)
+{
+	struct joy_state js[ROFE_MAX_PADS];
+	int p, b, nj;
+
+	memset(js, 0, sizeof js);
+	nj = plat_joy_poll(js, ROFE_MAX_PADS);
+
+	for (p = 0; p < ROFE_MAX_PADS; p++) {
+		uint16_t bits = 0;
+		int ax = 0, ay = 0, rx = 0, ry = 0;
+
+		if (have_focus)
+			for (b = 0; b < NBUTTONS; b++)
+				if (keymap[p][b] >= 0 && plat_key_down(keymap[p][b]))
+					bits |= 1u << b;
+
+		if (p < nj && js[p].present) {
+			const struct joy_state *j = &js[p];
+			int dx, dy;
+			for (b = 0; b < JOY_MAX_BUTTONS; b++)
+				if ((j->buttons >> b) & 1 && joymap[b] >= 0)
+					bits |= 1u << joymap[b];
+			if (joy_log && j->buttons != joy_last_buttons[p]) {
+				for (b = 0; b < JOY_MAX_BUTTONS; b++)
+					if (((j->buttons ^ joy_last_buttons[p]) >> b) & 1)
+						plat_log("Joystick %d: button %d %s\n", p + 1, b,
+						         (j->buttons >> b) & 1 ? "down" : "up");
+				joy_last_buttons[p] = j->buttons;
+			}
+			ax = deadzoned(j->x);
+			ay = deadzoned(j->y);
+			if (j->has_rstick) {
+				rx = deadzoned(j->rx);
+				ry = deadzoned(j->ry);
+			}
+			/* D-pad: the hat if there is one, else the left stick
+			   (when the stick isn't going to the core as an analogue
+			   stick). */
+			if (j->has_hat) {
+				dx = j->hat_x;
+				dy = j->hat_y;
+			} else if (!analog_sticks ||
+			           pad_device[p] == RETRO_DEVICE_JOYPAD) {
+				dx = ax < 0 ? -1 : ax > 0;
+				dy = ay < 0 ? -1 : ay > 0;
+			} else
+				dx = dy = 0;
+			if (dx < 0) bits |= 1u << RETRO_DEVICE_ID_JOYPAD_LEFT;
+			if (dx > 0) bits |= 1u << RETRO_DEVICE_ID_JOYPAD_RIGHT;
+			if (dy < 0) bits |= 1u << RETRO_DEVICE_ID_JOYPAD_UP;
+			if (dy > 0) bits |= 1u << RETRO_DEVICE_ID_JOYPAD_DOWN;
+		}
+		pad_bits[p] = bits;
+		pad_analog[p][0][0] = ax > 32767 ? 32767 : ax < -32767 ? -32767 : ax;
+		pad_analog[p][0][1] = ay > 32767 ? 32767 : ay < -32767 ? -32767 : ay;
+		pad_analog[p][1][0] = rx > 32767 ? 32767 : rx < -32767 ? -32767 : rx;
+		pad_analog[p][1][1] = ry > 32767 ? 32767 : ry < -32767 ? -32767 : ry;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* libretro callbacks                                                  */
+
+static void core_log(enum retro_log_level level, const char *fmt, ...)
+{
+	char buf[512];
+	va_list ap;
+	static const char *const lv[] = { "debug", "info", "warn", "error" };
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof buf, fmt, ap);
+	va_end(ap);
+	plat_log("[%s] %s", lv[level & 3], buf);
+}
+
+static void set_message(const char *msg, unsigned frames)
+{
+	snprintf(message, sizeof message, "%s", msg);
+	{
+		char *nl = strchr(message, '\n');
+		if (nl)
+			*nl = 0;
+	}
+	message_until = plat_time_cs() + (frames ? frames * 100 / 60 : 300);
+	plat_log("Message: %s\n", message);
+}
+
+static bool environment(unsigned cmd, void *data)
+{
+	switch (cmd) {
+	case RETRO_ENVIRONMENT_GET_LOG_INTERFACE:
+		((struct retro_log_callback *)data)->log = core_log;
+		return true;
+	case RETRO_ENVIRONMENT_GET_CORE_OPTIONS_VERSION:
+		*(unsigned *)data = 0;     /* plain SET_VARIABLES */
+		return true;
+	case RETRO_ENVIRONMENT_SET_VARIABLES:
+		opts_set_variables(data);
+		return true;
+	case RETRO_ENVIRONMENT_GET_VARIABLE: {
+		struct retro_variable *v = data;
+		v->value = opt_get(v->key);
+		return v->value != NULL;
+	}
+	case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE:
+		*(bool *)data = opts_changed != 0;
+		opts_changed = 0;
+		return true;
+	case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT:
+		return *(enum retro_pixel_format *)data == RETRO_PIXEL_FORMAT_XRGB8888;
+	case RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY:
+		*(const char **)data = sys_dir;
+		return true;
+	case RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY:
+		*(const char **)data = save_dir;
+		return true;
+	case RETRO_ENVIRONMENT_GET_CAN_DUPE:
+		*(bool *)data = true;
+		return true;
+	case RETRO_ENVIRONMENT_GET_INPUT_BITMASKS:
+		return true;
+	case RETRO_ENVIRONMENT_GET_CURRENT_SOFTWARE_FRAMEBUFFER: {
+		struct retro_framebuffer *fb = data;
+		int pitch = 0;
+		void *p;
+		if (fb_func == NULL)
+			return false;
+		p = fb_func(fb->width, fb->height, &pitch);
+		if (p == NULL)
+			return false;
+		fb->data = p;
+		fb->pitch = pitch;
+		fb->format = RETRO_PIXEL_FORMAT_XRGB8888;
+		fb->access_flags = RETRO_MEMORY_ACCESS_WRITE;
+		fb->memory_flags = RETRO_MEMORY_TYPE_CACHED;
+		return true;
+	}
+	case RETRO_ENVIRONMENT_SET_GEOMETRY:
+		av.geometry = *(const struct retro_game_geometry *)data;
+		return true;
+	case RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO:
+		av = *(const struct retro_system_av_info *)data;
+		return true;
+	case RETRO_ENVIRONMENT_SET_MESSAGE: {
+		const struct retro_message *m = data;
+		set_message(m->msg, m->frames);
+		return true;
+	}
+	case RETRO_ENVIRONMENT_GET_MESSAGE_INTERFACE_VERSION:
+		*(unsigned *)data = 0;
+		return true;
+	case RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS:
+	case RETRO_ENVIRONMENT_SET_CONTROLLER_INFO:
+	case RETRO_ENVIRONMENT_SET_PERFORMANCE_LEVEL:
+	case RETRO_ENVIRONMENT_SET_MEMORY_MAPS:
+	case RETRO_ENVIRONMENT_SET_DISK_CONTROL_INTERFACE:
+	case RETRO_ENVIRONMENT_SET_DISK_CONTROL_EXT_INTERFACE:
+	case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_DISPLAY:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void video_refresh(const void *data, unsigned width, unsigned height, size_t pitch)
+{
+	if (data == NULL)            /* same picture as before */
+		return;
+	if (fb_func) {
+		int p = 0;
+		void *dst = fb_func(width, height, &p);
+		if (dst == NULL)
+			return;
+		if (dst != data) {       /* the core used its own buffer: copy */
+			unsigned y;
+			for (y = 0; y < height; y++)
+				memcpy((char *)dst + y * p, (const char *)data + y * pitch,
+				       width * 4);
+		}
+		frame.buf = dst;
+		frame.pitch = p;
+	} else {
+		frame.buf = (void *)data;
+		frame.pitch = (int)pitch;
+	}
+	frame.width = (int)width;
+	frame.height = (int)height;
+	new_frame = 1;
+}
+
+static void audio_sample(int16_t l, int16_t r)
+{
+	if (audio_frames < (int)(sizeof audio_buf / 4)) {
+		audio_buf[audio_frames * 2] = l;
+		audio_buf[audio_frames * 2 + 1] = r;
+		audio_frames++;
+	}
+}
+
+static size_t audio_batch(const int16_t *data, size_t frames)
+{
+	size_t room = sizeof audio_buf / 4 - audio_frames;
+	size_t n = frames < room ? frames : room;
+	memcpy(audio_buf + audio_frames * 2, data, n * 4);
+	audio_frames += (int)n;
+	return frames;
+}
+
+static void input_poll(void)
+{
+}
+
+static int16_t input_state(unsigned port, unsigned device, unsigned index, unsigned id)
+{
+	if (port >= ROFE_MAX_PADS)
+		return 0;
+	switch (device & RETRO_DEVICE_MASK) {
+	case RETRO_DEVICE_JOYPAD:
+		if (id == RETRO_DEVICE_ID_JOYPAD_MASK)
+			return (int16_t)pad_bits[port];
+		return id < 16 ? (pad_bits[port] >> id) & 1 : 0;
+	case RETRO_DEVICE_ANALOG:
+		if (index < 2 && id < 2)
+			return pad_analog[port][index][id];
+		return 0;
+	default:
+		return 0;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Files                                                               */
+
+static void make_dirs(const char *path)
+{
+	char tmp[512], *p;
+	snprintf(tmp, sizeof tmp, "%s", path);
+	for (p = tmp + 1; *p; p++)
+		if (*p == '/') {
+			*p = 0;
+			mkdir(tmp, 0777);
+			*p = '/';
+		}
+	mkdir(tmp, 0777);
+}
+
+/* The leaf name without its extension (Unix form: "/a/b/Game.cue"). */
+static void set_game_name(const char *path)
+{
+	const char *leaf = strrchr(path, '/');
+	char *dot;
+	snprintf(game_name, sizeof game_name, "%s", leaf ? leaf + 1 : path);
+	dot = strrchr(game_name, '.');
+	if (dot && dot != game_name)
+		*dot = 0;
+	/* RISC OS names can't hold these; keep state file names simple */
+	for (dot = game_name; *dot; dot++)
+		if (*dot == '.' || *dot == ':' || *dot == '$' || *dot == '&' ||
+		    *dot == '@' || *dot == '^' || *dot == '%' || *dot == '\\' ||
+		    *dot == '#' || *dot == '*' || *dot == '"' || *dot == '|' ||
+		    *dot == ' ' || (unsigned char)*dot == 0xA0 || *dot == '/')
+			*dot = '_';
+}
+
+static int read_file(const char *path, void *buf, size_t size)
+{
+	FILE *f = fopen(path, "rb");
+	size_t n;
+	if (f == NULL)
+		return -1;
+	n = fread(buf, 1, size, f);
+	fclose(f);
+	return (int)n;
+}
+
+static int write_file(const char *path, const void *buf, size_t size)
+{
+	FILE *f = fopen(path, "wb");
+	size_t n;
+	if (f == NULL)
+		return 0;
+	n = fwrite(buf, 1, size, f);
+	if (fclose(f) != 0)
+		n = 0;
+	return n == size;
+}
+
+/* Memory card 1 when the "libretro" type is chosen: saves/<game>.srm */
+static unsigned char *sram_copy;
+static size_t sram_size;
+
+static void sram_path(char *buf, size_t len)
+{
+	snprintf(buf, len, "%s/%s.srm", save_dir, game_name);
+}
+
+static void sram_load(void)
+{
+	char path[640];
+	void *mem = retro_get_memory_data(RETRO_MEMORY_SAVE_RAM);
+	size_t size = retro_get_memory_size(RETRO_MEMORY_SAVE_RAM);
+	free(sram_copy);
+	sram_copy = NULL;
+	sram_size = 0;
+	if (mem == NULL || size == 0)
+		return;
+	sram_path(path, sizeof path);
+	if (read_file(path, mem, size) > 0)
+		plat_log("Memory card from %s\n", path);
+	sram_copy = malloc(size);
+	if (sram_copy) {
+		memcpy(sram_copy, mem, size);
+		sram_size = size;
+	}
+}
+
+void host_flush_saves(void)
+{
+	char path[640];
+	void *mem;
+	if (!game_loaded || sram_copy == NULL)
+		return;
+	mem = retro_get_memory_data(RETRO_MEMORY_SAVE_RAM);
+	if (mem == NULL || memcmp(mem, sram_copy, sram_size) == 0)
+		return;
+	make_dirs(save_dir);
+	sram_path(path, sizeof path);
+	if (write_file(path, mem, sram_size)) {
+		memcpy(sram_copy, mem, sram_size);
+		plat_log("Memory card saved to %s\n", path);
+	} else
+		plat_log("Couldn't write %s: %s\n", path, strerror(errno));
+}
+
+/* ------------------------------------------------------------------ */
+/* The interface for wimp.c                                            */
+
+int host_init(const char *system_dir, const char *save_d, const char *state_d,
+              host_fb_func fb)
+{
+	snprintf(sys_dir, sizeof sys_dir, "%s", system_dir);
+	snprintf(save_dir, sizeof save_dir, "%s", save_d);
+	snprintf(state_dir, sizeof state_dir, "%s", state_d);
+	make_dirs(sys_dir);
+	make_dirs(save_dir);
+	fb_func = fb;
+	load_input_map();
+	analog_sticks = 1;
+
+	retro_set_environment(environment);
+	retro_set_video_refresh(video_refresh);
+	retro_set_audio_sample(audio_sample);
+	retro_set_audio_sample_batch(audio_batch);
+	retro_set_input_poll(input_poll);
+	retro_set_input_state(input_state);
+	retro_init();
+	plat_log("Core: %d options\n", nopts);
+	return 1;
+}
+
+void host_shutdown(void)
+{
+	int i;
+	host_unload_game();
+	retro_deinit();
+	if (audio_open)
+		plat_audio_close();
+	audio_open = 0;
+	for (i = 0; i < nopts; i++)
+		free(opts[i].values);
+	nopts = 0;
+}
+
+int host_load_game(const char *path)
+{
+	struct retro_game_info info;
+	int p;
+
+	host_unload_game();
+	memset(&info, 0, sizeof info);
+	info.path = path;
+	set_game_name(path);
+	plat_log("Loading %s\n", path);
+	if (!retro_load_game(&info)) {
+		plat_log("The core couldn't load %s\n", path);
+		game_name[0] = 0;
+		return 0;
+	}
+	game_loaded = 1;
+	{
+		int i;
+		for (i = 0; i < nopts; i++)
+			plat_log("Option %s: %s\n", opts[i].key, opts[i].value);
+	}
+	for (p = 0; p < ROFE_MAX_PADS; p++) {
+		pad_device[p] = pad_type_from_choices(p);
+		retro_set_controller_port_device(p, pad_device[p]);
+	}
+	retro_get_system_av_info(&av);
+	plat_log("Loaded \"%s\": %dx%d, %.3f fps, %.0f Hz\n", game_name,
+	         av.geometry.base_width, av.geometry.base_height,
+	         av.timing.fps, av.timing.sample_rate);
+	sram_load();
+	if (!audio_open && choices_get_int("sound", 1)) {
+		int rate = (int)(av.timing.sample_rate + 0.5);
+		int block = (int)(rate / av.timing.fps + 1) * 4;
+		audio_open = plat_audio_open(rate, block);
+	}
+	frame.buf = NULL;
+	return 1;
+}
+
+void host_unload_game(void)
+{
+	if (!game_loaded)
+		return;
+	host_flush_saves();
+	retro_unload_game();
+	game_loaded = 0;
+	game_name[0] = 0;
+	frame.buf = NULL;
+	free(sram_copy);
+	sram_copy = NULL;
+	if (audio_open)
+		plat_audio_pause(1);
+}
+
+int host_game_loaded(void)
+{
+	return game_loaded;
+}
+
+const char *host_game_name(void)
+{
+	return game_name;
+}
+
+void host_reset(void)
+{
+	if (game_loaded)
+		retro_reset();
+}
+
+double host_fps(void)
+{
+	return av.timing.fps > 1 ? av.timing.fps : 60.0;
+}
+
+int host_audio_rate(void)
+{
+	return audio_open ? (int)(av.timing.sample_rate + 0.5) : 0;
+}
+
+void host_run_frame(int have_focus)
+{
+	if (!game_loaded)
+		return;
+	poll_input(have_focus);
+	audio_frames = 0;
+	retro_run();
+	if (audio_open && audio_frames)
+		plat_audio_write(audio_buf, audio_frames * 4);
+}
+
+const struct host_video *host_frame(int *is_new)
+{
+	if (is_new) {
+		*is_new = new_frame;
+		new_frame = 0;
+	}
+	return frame.buf ? &frame : NULL;
+}
+
+static void state_path(char *buf, size_t len, int slot)
+{
+	snprintf(buf, len, "%s/%s/%d", state_dir, game_name, slot);
+}
+
+int host_save_state(int slot)
+{
+	char path[700], dir[640];
+	size_t size;
+	void *buf;
+	int ok;
+	if (!game_loaded)
+		return 0;
+	size = retro_serialize_size();
+	buf = malloc(size);
+	if (buf == NULL)
+		return 0;
+	ok = retro_serialize(buf, size);
+	if (ok) {
+		snprintf(dir, sizeof dir, "%s/%s", state_dir, game_name);
+		make_dirs(dir);
+		state_path(path, sizeof path, slot);
+		ok = write_file(path, buf, size);
+		plat_log("Save state %d to %s: %s\n", slot, path, ok ? "done" : strerror(errno));
+	}
+	free(buf);
+	return ok;
+}
+
+int host_load_state(int slot)
+{
+	char path[700];
+	size_t size;
+	void *buf;
+	int n, ok = 0;
+	if (!game_loaded)
+		return 0;
+	size = retro_serialize_size();
+	buf = malloc(size);
+	if (buf == NULL)
+		return 0;
+	state_path(path, sizeof path, slot);
+	n = read_file(path, buf, size);
+	if (n > 0)
+		ok = retro_unserialize(buf, (size_t)n);
+	plat_log("Load state %d from %s: %s\n", slot, path,
+	         n <= 0 ? "no such file" : ok ? "done" : "refused");
+	free(buf);
+	return ok;
+}
+
+void host_reload_choices(void)
+{
+	int p;
+	load_input_map();
+	opts_resolve();
+	if (game_loaded)
+		for (p = 0; p < ROFE_MAX_PADS; p++) {
+			unsigned d = pad_type_from_choices(p);
+			if (d != pad_device[p]) {
+				pad_device[p] = d;
+				retro_set_controller_port_device(p, d);
+			}
+		}
+}
+
+const char *host_message(unsigned now)
+{
+	if (message[0] && (int)(message_until - now) > 0)
+		return message;
+	return NULL;
+}
